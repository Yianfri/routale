# BITACORA_* es el prefijo técnico heredado de Routale; conservar estos nombres.
# Completar con las dos imágenes aprobadas y verificadas en OPS-02, cada una por su digest.
# Estos marcadores no son imágenes instalables. No usar latest ni etiquetas mutables.
BITACORA_IMAGE=ghcr.io/yianfri/routale@sha256:REEMPLAZAR_POR_DIGEST_WEB
BITACORA_API_IMAGE=ghcr.io/yianfri/routale-api@sha256:REEMPLAZAR_POR_DIGEST_API
# Ingreso privado desde Tailscale Serve; conservar loopback.
BITACORA_BIND_IP=127.0.0.1
BITACORA_PORT=8088
BITACORA_DATA_VOLUME=routale_private_data
# Comprobar que esta red no colisione con las existentes antes de la primera instalación.
BITACORA_NETWORK_SUBNET=172.30.40.0/24
BITACORA_NETWORK_GATEWAY=172.30.40.1
BITACORA_WEB_IP=172.30.40.2
BITACORA_API_IP=172.30.40.3
